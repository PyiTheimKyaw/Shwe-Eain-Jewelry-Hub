@startuml timebox1_platform_usecase
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Customer" as Customer
actor "Admin" as Admin

rectangle "Timebox 1: Platform Foundation & Core Catalog" {
  package "Customer App" {
    usecase "Register / Login" as UC_Login
    usecase "Browse Catalog" as UC_Browse
    usecase "View Product Detail" as UC_Detail
    usecase "Toggle Currency/Weight Display" as UC_Display
  }

  package "Admin (Filament)" {
    usecase "Manage Categories" as UC_Cat
    usecase "Manage Products" as UC_Prod
    usecase "Manage Product Images" as UC_Img
    usecase "Record Gold Snapshot" as UC_Gold
    usecase "Record FX Snapshot" as UC_Fx
  }
}

Customer -- UC_Login
Customer -- UC_Browse
Customer -- UC_Detail
Customer -- UC_Display

Admin -- UC_Cat
Admin -- UC_Prod
Admin -- UC_Img
Admin -- UC_Gold
Admin -- UC_Fx

@enduml

