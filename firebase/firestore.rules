rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Custom tokens must include claims: role (admin|customer|artisan), thread_id (UUID string), inquiry_id (number).
// Laravel mints tokens via kreait/firebase-php; UIDs are "laravel_{user_id}".

service cloud.firestore {
  match /databases/{database}/documents {

    match /inquiry_threads/{threadId} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'customer' && request.auth.token.thread_id == threadId)
      );
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.token.role == 'admin' ||
          (request.auth.token.role == 'customer' && request.auth.token.thread_id == threadId)
        );
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['text', 'sender_role'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.sender_role is string
          && (
            (request.auth.token.role == 'admin' && request.resource.data.sender_role == 'admin')
            || (request.auth.token.role == 'customer'
                && request.auth.token.thread_id == threadId
                && request.resource.data.sender_role == 'customer')
          );
        allow update, delete: if false;
      }
    }
  }
}
