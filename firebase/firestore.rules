rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// quote_card and payment_info_card messages are server-only (Admin SDK). Clients send type "text" or "image".

service cloud.firestore {
  match /databases/{database}/documents {

    match /inquiry_threads/{threadId} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'customer' && request.auth.token.thread_id == threadId)
      );
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.token.role == 'admin' ||
          (request.auth.token.role == 'customer' && request.auth.token.thread_id == threadId)
        );

        function participantOk() {
          return (request.auth.token.role == 'admin' && request.resource.data.sender_role == 'admin')
            || (request.auth.token.role == 'customer'
                && request.auth.token.thread_id == threadId
                && request.resource.data.sender_role == 'customer');
        }

        // Legacy: text + sender_role only (no type)
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['text', 'sender_role'])
          && !request.resource.data.keys().hasAny(['type'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.sender_role is string
          && participantOk();

        // Typed text (Messenger-style)
        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['type', 'text', 'sender_role', 'created_at'])
          && request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.sender_role is string
          && participantOk();

        allow create: if request.auth != null
          && request.resource.data.keys().hasAll(['type', 'image_url', 'sender_role', 'created_at'])
          && request.resource.data.type == 'image'
          && request.resource.data.image_url is string
          && request.resource.data.image_url.size() > 0
          && request.resource.data.image_url.size() <= 2000
          && request.resource.data.sender_role is string
          && participantOk();

        allow update, delete: if false;
      }
    }
  }
}
